{
  "Jwt": {
    "Key": "change-this-to-a-long-random-string-at-least-32-chars!!",
    "Issuer": "EquityLens.Api",
    "Audience": "EquityLens.Web",
    "ExpireMinutes": "60",
    "RefreshExpireDays": "7"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost:5432;Database=equitylens;Username=equitylens;Password=equitylens_dev_password"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "JobsStreamKey": "equitylens:jobs",
    "ConsumerGroupName": "equitylens-workers",
    "CacheKeyPrefix": "equitylens:cache",
    "DefaultCacheMinutes": 15
  },
  "RiskPython": {
    "ShadowEnabled": false,
    "JobsStreamKey": "equitylens:risk-python:jobs",
    "JobsConsumerGroup": "risk-python-workers",
    "ResultsStreamKey": "equitylens:risk-python:results",
    "ResultsConsumerGroup": "risk-shadow-result-consumers",
    "DeadLetterStreamKey": "equitylens:risk-python:dead-letter",
    "PayloadKeyPrefix": "equitylens:risk-python",
    "CandidateAlgorithmVersion": "mvewma-fhs-python-v1",
    "PayloadTtlHours": 24,
    "ResultPollSeconds": 1
  },
  "AgentRunQueue": {
    "StreamKey": "equitylens:agent-runs:stream",
    "ConsumerGroupName": "agent-run-workers",
    "PendingMinIdleSeconds": 300
  },
  "ObjectStorage": {
    "ServiceUrl": "http://localhost:9000",
    "Region": "garage",
    "BucketName": "equitylens",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "ForcePathStyle": true,
    "PresignedUrlExpiryMinutes": 15
  },
  "AI": {
    "ChatProvider": "Gemini"
  },
  "DeepSeek": {
    "BaseUrl": "https://api.deepseek.com",
    "Model": "deepseek-chat",
    "ApiKey": ""
  },
  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/",
    "Model": "gemini-3.1-flash-lite",
    "ApiKey": ""
  },
  "OpenAI": {
    "ApiKey": ""
  },
  "MarketData": {
    "AlphaVantage": {
      "BaseUrl": "https://www.alphavantage.co",
      "ApiKey": "YOUR_ALPHA_VANTAGE_API_KEY"
    },
    "FinMind": {
      "BaseUrl": "https://api.finmindtrade.com",
      "Token": "YOUR_FINMIND_TOKEN"
    }
  },
  "Jina": {
    "ApiKey": "",
    "BaseUrl": "https://api.jina.ai/v1",
    "RerankModel": "jina-reranker-v3"
  },
  "Brave": {
    "ApiKey": "",
    "BaseUrl": "https://api.search.brave.com/res/v1/web/search",
    "DefaultCount": 10
  },
  "Retrieval": {
    "DefaultTopK": 10,
    "MaxTopK": 20,
    "MinimumCandidateScore": 0.0,
    "MinimumFinalScore": 0.0,
    "PrimarySourceBonus": 0.05,
    "RiskEvidenceBonus": 0.10,
    "FinancialEvidenceBonus": 0.12,
    "OutlookEvidenceBonus": 0.12,
    "AgendaPenalty": 0.20,
    "SafeHarborPenalty": 0.15,
    "FirstPagePenalty": 0.10,
    "AutoPrimaryRatio": 0.7,
    "MaxSafeHarborChunks": 1,
    "MaxCitationRetries": 1,
    "LocalCandidateCountForRerank": 30,
    "WebSearchCandidateCount": 10,
    "WebContextLimit": 3,
    "WebSearchMaxContentLength": 3000,
    "WebSearchFreshness": "month",
    "EnableJinaRerank": false
  }
}
