{
	admin off
}

:2015 {
	respond /healthz "ok" 200
}

equitylens.duckdns.org {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode zstd gzip

	@health path /healthz
	respond @health "ok" 200

	# Download-only S3 proxy. Preserve host/path/query: all are covered by the signature.
	@objectDownload {
		method GET
		path /equitylens/*
		query X-Amz-Algorithm=AWS4-HMAC-SHA256
	}
	handle @objectDownload {
		header Content-Security-Policy "default-src 'none'; sandbox"
		header Cache-Control "private, no-store"
		reverse_proxy garage:3900
	}
	handle {
		reverse_proxy api:5034
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
	}

	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					replace X-Amz-Signature REDACTED
					replace X-Amz-Credential REDACTED
					delete X-Amz-Security-Token
				}
			}
		}
	}
}
