{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	@health path /healthz
	respond @health "ok" 200

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cache-Control "no-store"
	}

	root * /srv
	file_server

	log {
		output stdout
		format console
	}
}
