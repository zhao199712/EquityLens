# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.cs text diff=csharp
*.cshtml text
*.razor text
*.css text
*.js text
*.ts text
*.vue text
*.json text
*.md text
*.yml text
*.yaml text
*.xml text
*.config text
*.props text
*.targets text

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
